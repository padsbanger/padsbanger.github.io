---
import Layout from '../layouts/Layout.astro';

import '../styles/home.css';
import '../styles/services.css';

const contactUrl =
	'mailto:kontakt@michal-lach.pl?subject=Fixed-scope%20frontend%20fix&body=Repository%20or%20project%20URL%3A%0AProblem%3A%0ADefinition%20of%20done%3A%0ADeadline%3A';
const githubContactUrl =
	'https://github.com/padsbanger/padsbanger.github.io/issues/new?template=fixed-scope-request.yml&title=%5BScope%5D%20';
const triageGithubContactUrl =
	'https://github.com/padsbanger/padsbanger.github.io/issues/new?template=fixed-scope-request.yml&title=%5BTriage%5D%20';
const ugigDiagnosticUrl =
	'https://ugig.net/for-hire/aae8655a-206a-41ab-8d93-94d9ac771cd2';

const structuredData = {
	'@context': 'https://schema.org',
	'@type': 'Service',
	name: 'Fixed-scope React and TypeScript code fix',
	description:
		'One bounded React, TypeScript, or JavaScript bug fix, failing test repair, or API integration delivered with verification evidence.',
	provider: {
		'@type': 'Person',
		name: 'Michał Lach',
		url: 'https://michal-lach.pl',
	},
	areaServed: 'Worldwide',
	serviceType: 'Frontend software engineering',
	offers: [
		{
			'@type': 'Offer',
			name: 'Frontend issue diagnostic',
			price: '5',
			priceCurrency: 'USD',
			availability: 'https://schema.org/LimitedAvailability',
			url: 'https://michal-lach.pl/services/#options',
		},
		{
			'@type': 'Offer',
			name: 'Fixed-scope frontend implementation',
			price: '25',
			priceCurrency: 'USD',
			availability: 'https://schema.org/LimitedAvailability',
			url: 'https://michal-lach.pl/services/#options',
		},
	],
};
---

<Layout
	title="24-hour React & TypeScript code fix — Michał Lach"
	description="A $5 bounded frontend diagnostic or $25 fixed-scope React, TypeScript, or JavaScript code fix, delivered with reproducible verification evidence."
	keywords={[
		'React bug fix',
		'TypeScript code fix',
		'JavaScript debugging',
		'frontend code review',
		'fixed scope developer',
	]}
	structuredData={structuredData}
>
	<div class="top-anchor" id="top" aria-hidden="true"></div>

	<header class="site-header service-header">
		<a href="/" class="brand" aria-label="Back to Michał Lach portfolio">
			<span class="brand-mark">ML</span>
			<span class="brand-name">Fixed-scope delivery</span>
		</a>
		<nav class="nav" aria-label="Service page">
			<a href="#options"><span class="num">01</span> Options</a>
			<a href="#fit"><span class="num">02</span> Fit</a>
			<a href="#proof"><span class="num">03</span> Proof</a>
		</nav>
		<div class="header-actions">
			<button type="button" class="theme-toggle" id="theme-toggle" aria-label="Toggle dark mode" title="Toggle theme">
				<svg class="icon-moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" />
				</svg>
				<svg class="icon-sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
					<circle cx="12" cy="12" r="4" />
					<path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
				</svg>
			</button>
			<a href={githubContactUrl} class="btn btn--solid" data-service-cta="header-github">Open a request</a>
		</div>
	</header>

	<main>
		<section class="hero service-hero">
			<div class="hero-frame">
				<span class="tick tick--tl" aria-hidden="true"></span>
				<span class="tick tick--tr" aria-hidden="true"></span>
				<span class="tick tick--bl" aria-hidden="true"></span>
				<span class="tick tick--br" aria-hidden="true"></span>

				<div class="hero-meta" aria-hidden="true">
					<span>One issue · One price · One handoff</span>
					<span>React / TypeScript / JavaScript</span>
					<span class="service-live">Booking one bounded task</span>
				</div>

				<p class="eyebrow">24-hour fixed-scope frontend delivery</p>
				<h1 class="hero-title service-title">
					<span>Unblock one</span>
					<span>frontend <span class="accent">issue.</span></span>
				</h1>
				<p class="hero-sub">
					Send one reproducible bug, failing test, or small integration. I return a focused
					patch or pull request with tests or explicit verification notes—without turning it
					into an open-ended engagement.
				</p>

				<dl class="readouts">
					<div class="readout"><dt>Diagnostic</dt><dd>$5 fixed</dd></div>
					<div class="readout"><dt>Target</dt><dd>Within 24 hours</dd></div>
					<div class="readout"><dt>Implementation</dt><dd>$25 fixed</dd></div>
					<div class="readout"><dt>Start gate</dt><dd>Written scope</dd></div>
				</dl>

				<div class="hero-actions">
					<a href={triageGithubContactUrl} class="btn btn--solid" data-service-cta="hero-triage">Start a $5 diagnostic</a>
					<a href={ugigDiagnosticUrl} class="btn btn--ghost" data-service-cta="hero-ugig">Hire for $5 on uGig</a>
					<a href={githubContactUrl} class="btn btn--ghost" data-service-cta="hero-github">Request the $25 fix</a>
					<a href={contactUrl} class="btn btn--ghost" data-service-cta="hero-email">Send by email</a>
				</div>
			</div>

			<div class="metrics">
				<div class="metric"><span class="metric-num">10+</span><span class="metric-label">Years shipping<br />production UI</span></div>
				<div class="metric"><span class="metric-num">01</span><span class="metric-label">Bounded issue<br />per engagement</span></div>
				<div class="metric"><span class="metric-num">24h</span><span class="metric-label">Target<br />turnaround</span></div>
				<div class="metric"><span class="metric-num">$5</span><span class="metric-label">Low-risk<br />diagnostic</span></div>
			</div>
		</section>

		<section class="section section--alt" id="options">
			<div class="section-head">
				<span class="section-num">01</span>
				<h2 class="section-title">Choose the smallest useful result</h2>
				<p class="section-desc">Start with evidence only, or buy the bounded implementation. The diagnostic is credited if the same issue proceeds to a fix.</p>
			</div>
			<div class="service-options">
				<article class="service-option">
					<div class="service-option-head"><span>Diagnostic</span><strong>$5</strong></div>
					<h3>Know where the issue lives</h3>
					<p>For one public, reproducible frontend issue: a root-cause note, the relevant files and code path, a focused fix outline, and one verification command. No code change is included.</p>
					<ul>
						<li>Written result within 4 hours of accepted scope</li>
						<li>Binary deliverable—no open-ended consulting</li>
						<li>Full $5 credited toward the same $25 fix</li>
					</ul>
					<a href={triageGithubContactUrl} class="btn btn--solid" data-service-cta="options-triage">Request the $5 diagnostic</a>
					<a href={ugigDiagnosticUrl} class="btn btn--ghost" data-service-cta="options-ugig">Pay with Lightning</a>
				</article>
				<article class="service-option service-option--primary">
					<div class="service-option-head"><span>Implementation</span><strong>$25</strong></div>
					<h3>Receive the patch and proof</h3>
					<p>For one agreed frontend issue: diagnosis, implementation, and a reviewable pull request or patch with focused automated tests or explicit verification notes.</p>
					<ul>
						<li>Target delivery within 24 hours</li>
						<li>One written scope and acceptance check</li>
						<li>One focused correction pass if criteria are missed</li>
					</ul>
					<a href={githubContactUrl} class="btn btn--solid" data-service-cta="options-fix">Request the $25 fix</a>
				</article>
			</div>
		</section>

		<section class="section" id="fit">
			<div class="section-head">
				<span class="section-num">02</span>
				<h2 class="section-title">Good fit</h2>
				<p class="section-desc">Small enough to verify quickly, important enough to stop blocking your release.</p>
			</div>
			<div class="cases service-grid">
				<article class="case">
					<div class="case-meta"><span class="case-tag">Debug</span><span>React / Next.js</span></div>
					<h3 class="case-title">Reproducible UI bug</h3>
					<p class="case-text">A broken interaction, state transition, rendering edge case, or regression with a clear expected result.</p>
					<div class="case-stack"><span>React</span><span>State</span><span>Rendering</span></div>
				</article>
				<article class="case">
					<div class="case-meta"><span class="case-tag">Repair</span><span>Tests / CI</span></div>
					<h3 class="case-title">Failing frontend test</h3>
					<p class="case-text">One flaky or consistently failing test traced to its cause, fixed narrowly, and returned with a repeatable command.</p>
					<div class="case-stack"><span>Vitest</span><span>Jest</span><span>RTL</span></div>
				</article>
				<article class="case">
					<div class="case-meta"><span class="case-tag">Integrate</span><span>REST / GraphQL</span></div>
					<h3 class="case-title">Small API integration</h3>
					<p class="case-text">One typed endpoint or client flow, including loading/error behavior and concise usage notes.</p>
					<div class="case-stack"><span>TypeScript</span><span>Fetch</span><span>GraphQL</span></div>
				</article>
				<article class="case">
					<div class="case-meta"><span class="case-tag">Review</span><span>Focused evidence</span></div>
					<h3 class="case-title">PR rescue or code review</h3>
					<p class="case-text">A bounded review or correction pass with file-level findings, verification, and a maintainer-ready handoff.</p>
					<div class="case-stack"><span>Scope</span><span>Risk</span><span>Verification</span></div>
				</article>
			</div>
		</section>

		<section class="section section--alt" id="proof">
			<div class="section-head">
				<span class="section-num">03</span>
				<h2 class="section-title">Recent proof</h2>
				<p class="section-desc">The deliverable—not the promise—is the useful unit.</p>
			</div>
			<a class="proof-card" href="https://github.com/moshcoder/moshcode/pull/32" target="_blank" rel="noopener">
				<div>
					<span class="proof-label">Merged pull request · July 2026</span>
					<h3>Skip sleep during MoshScript dry runs</h3>
					<p>Located the dry-run behavior, added the focused fix, passed all checks, and delivered the result as a reviewable pull request.</p>
				</div>
				<span class="proof-state">MERGED ↗</span>
			</a>
			<a class="proof-card" href="https://ugig.net/skills/verify-paid-bounties-before-you-work" target="_blank" rel="noopener">
				<div>
					<span class="proof-label">Clean agent skill · August 2026 · 2,500 sats</span>
					<h3>Verify paid bounties before doing the work</h3>
					<p>Resolve the canonical source, funding, eligibility, legal state, payout friction, and expected value before committing time or credentials.</p>
				</div>
				<span class="proof-state">VIEW ↗</span>
			</a>
		</section>

		<section class="section" id="process">
			<div class="section-head">
				<span class="section-num">04</span>
				<h2 class="section-title">Simple process</h2>
			</div>
			<ol class="service-process">
				<li><span>01</span><div><strong>Send the evidence</strong><p>Repository or project URL, reproduction steps, definition of done, and deadline.</p></div></li>
				<li><span>02</span><div><strong>Confirm the boundary</strong><p>I reply with the exact fixed scope, price, delivery target, and anything explicitly excluded.</p></div></li>
				<li><span>03</span><div><strong>Receive a verifiable handoff</strong><p>Pull request or patch, test output or manual verification notes, and one focused correction pass if the agreed criteria are missed.</p></div></li>
			</ol>
		</section>

		<section class="section section--contact service-contact">
			<div class="section-head">
				<span class="section-num">05</span>
				<h2 class="section-title">Send one issue</h2>
			</div>
			<p class="contact-lead">If it cannot be bounded and verified, I will say so before any work starts.</p>
			<div class="hero-actions service-contact-actions">
				<a href={triageGithubContactUrl} class="btn btn--solid" data-service-cta="contact-triage">Start a $5 diagnostic</a>
				<a href={ugigDiagnosticUrl} class="btn btn--ghost" data-service-cta="contact-ugig">Hire for $5 on uGig</a>
				<a href={githubContactUrl} class="btn btn--ghost" data-service-cta="contact-github">Request the $25 fix</a>
				<a href={contactUrl} class="btn btn--ghost" data-service-cta="contact-email">Send a private email</a>
			</div>
			<p class="service-privacy">Do not include credentials, private code, or confidential details in a public GitHub request.</p>
			<a href={contactUrl} class="contact-mail service-email" data-service-cta="contact-address">kontakt@michal-lach.pl</a>
			<p class="service-fineprint">Both prices apply to one small issue with an accessible codebase and clear acceptance criteria. The $5 diagnostic contains no code change and is credited only toward implementation of that same issue. Larger scope is quoted before work begins.</p>
		</section>
	</main>

	<footer class="site-footer service-footer">
		<a href="/">← Full engineering portfolio</a>
		<span>Fixed scope · Written acceptance · Verifiable handoff</span>
		<a href="#top">Back to top ↑</a>
	</footer>

	<script>
		import { initThemeToggle } from '../scripts/home/theme';
		initThemeToggle();

		document.querySelectorAll<HTMLElement>('[data-service-cta]').forEach((element) => {
			element.addEventListener('click', () => {
				const analytics = window as typeof window & {
					gtag?: (...args: unknown[]) => void;
				};
				analytics.gtag?.('event', 'service_scope_click', {
					event_category: 'lead',
					event_label: element.dataset.serviceCta,
					traffic_source: new URLSearchParams(window.location.search).get('ref') ?? 'direct',
				});
			});
		});
	</script>
</Layout>
